# Copy to .env.local (local) and add the same vars in Vercel → Project → Settings → Environment Variables.

# REQUIRED. Google sign-in + Drive export: OAuth "Web application" client ID from console.cloud.google.com (see README).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# REQUIRED. Signs the login cookie. Any long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# REQUIRED. Vercel Blob store (Vercel → Storage → Blob → connect to the project; this var is added for you).
BLOB_READ_WRITE_TOKEN=

# Optional. Protects the daily cleanup of old uploads (vercel.json cron). Any random string.
CRON_SECRET=

# Optional. Your production address (e.g. my-higgsview.vercel.app): other *.vercel.app names of the deployment redirect to it.
SITE_HOST=

# Optional. Shows a "Help & feedback" link that opens an email to this address, and puts it on the Privacy page.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional. Who runs this site (shown on the Privacy page).
NEXT_PUBLIC_SITE_OWNER=

# Optional. Google API key with the Picker API enabled: adds "Choose folder…" for Drive exports.
NEXT_PUBLIC_GOOGLE_API_KEY=

# Optional. This Google account may use the server's own Kie key below; everyone else pastes their own key in the app.
OWNER_EMAIL=
KIE_API_KEY=
